generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int        @id @default(autoincrement())
  username String
  email    String     @unique
  password String
  memories Memories[]
}

model Memories {
  id                      String                   @id
  userId                  Int
  content                 String
  metadata                Json
  schemaVersion           Int                      @default(1)
  createdAt               DateTime                 @default(now())
  userTitle               String?
  tags                    String[]                 @default([])
  processingState         String                   @default("PERSISTED")
  embedding               Unsupported("vector")?
  modelVersion            String?
  tsVectorTags            Unsupported("tsvector")?
  userNote                String?
  embeddingGeneratedAt    DateTime?
  retryCount              Int                      @default(0)
  tsVectorTagsGeneratedAt DateTime?
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
